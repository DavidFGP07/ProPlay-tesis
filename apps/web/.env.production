# Configuración del build de producción (Vercel). Se versiona porque no tiene
# secretos: todo lo VITE_* acaba en el bundle y es público.
#
# La API se llama en el mismo dominio de la web: vercel.json reenvía /api/* a
# la API de Azure, así la cookie del refresh token es del mismo sitio y Safari
# no la bloquea como cookie de terceros.
VITE_API_URL=/api/v1
# Sólo lo real: sin el puente de datos de demostración.
VITE_DEMO_DATA=false
